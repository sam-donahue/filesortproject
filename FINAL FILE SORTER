from datetime import datetime

INPUT_FILE = "samplefiles.txt"


def datavalidator(phrase, maxnum):
    while True:
        num = input(phrase)
        try:
            val = int(num)
            if 1 <= val <= maxnum:
                return val
            print(f"Integer out of bounds. Please enter a number from 1 to {maxnum}.")
        except ValueError:
            print("Value is not an integer. Please select a valid option.")


def read_entries():
    try:
        with open(INPUT_FILE, "r") as file:
            return [line.strip() for line in file if line.strip()]
    except FileNotFoundError:
        return []


def write_entries(filename, lines):
    with open(filename, "w") as file:
        for line in lines:
            file.write(line + "\n")


def parse_entry(entry):
    parts = entry.split(".")

    if len(parts) != 6:
        return None

    try:
        date_obj = datetime.strptime(parts[0], "%m-%d-%Y")
    except ValueError:
        return None

    return {
        "full": entry,
        "date": date_obj,
        "day": parts[1],
        "name": parts[2],
        "subject": parts[3],
        "size": parts[4],
        "dslo": parts[5]
    }


def mainmenu():
    print("\n1 - Organize Files")
    print("2 - Add File")
    print("3 - Exit")

    selection = datavalidator("Enter a selection: ", 3)

    match selection:
        case 1:
            organize_files()
        case 2:
            fileappender()
        case 3:
            print("Goodbye.")
            return False

    return True


def sortby():
    print("\nOrganize By:")
    print("1 - Date")
    print("2 - Subject")
    print("3 - Name")

    return datavalidator("Enter a selection: ", 3)


def organize_files():
    entries = read_entries()

    if not entries:
        print("No entries found.")
        return

    parsed = []

    for entry in entries:
        parsed_entry = parse_entry(entry)
        if parsed_entry is not None:
            parsed.append(parsed_entry)

    if not parsed:
        print("No valid entries.")
        return

    sortans = sortby()

    if sortans == 1:
        sorted_entries = sorted(parsed, key=lambda x: x["date"])
        method = "date"

    elif sortans == 2:
        sorted_entries = sorted(parsed, key=lambda x: x["subject"].lower())
        method = "subject"

    else:
        sorted_entries = sorted(parsed, key=lambda x: x["name"].lower())
        method = "name"

    output_file = f"organized_by_{method}.txt"

    write_entries(output_file, [x["full"] for x in sorted_entries])

    print(f"\nSaved to {output_file}")


def fileappender():
    print("\nEnter new file in this format:")
    print("MM-DD-YYYY.day.name.subject.size.dslo")

    new_entry = input("New entry: ").strip()

    if parse_entry(new_entry) is None:
        print("Invalid format. Not added.")
        return

    with open(INPUT_FILE, "a") as file:
        file.write(new_entry + "\n")

    print("Entry added.")


# MAIN

running = True

while running:
    running = mainmenu()
