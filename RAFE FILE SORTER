from datetime import datetime

INPUT_FILE = "samplefiles.txt"


def main_menu():
    print("\n1 - Organize Files")
    print("2 - Add File")
    print("3 - Exit")

    while True:
        choice = input("Enter a selection: ").strip()
        if choice in ("1", "2", "3"):
            return choice
        print("Please enter 1, 2, or 3.")


def organize_menu():
    print("\nOrganize By:")
    print("1 - Date")
    print("2 - Subject")
    print("3 - Name")

    while True:
        choice = input("Enter a selection: ").strip()
        if choice in ("1", "2", "3"):
            return choice
        print("Please enter 1, 2, or 3.")


def read_entries():
    try:
        with open(INPUT_FILE, "r") as file:
            return [line.strip() for line in file if line.strip()]
    except FileNotFoundError:
        return []


def write_entries(filename, lines):
    with open(filename, "w") as file:
        for line in lines:
            file.write(line + "\n")


def parse_entry(entry):
    parts = entry.split(".")

    if len(parts) != 6:
        return None

    try:
        date_obj = datetime.strptime(parts[0], "%m-%d-%Y")
    except ValueError:
        return None

    return {
        "full": entry,
        "date": date_obj,
        "name": parts[2],
        "subject": parts[3]
    }


def add_file():
    print("\nEnter new file in this format:")
    print("MM-DD-YYYY.day.name.subject.size.dslo")

    new_entry = input("New entry: ").strip()

    if parse_entry(new_entry) is None:
        print("Invalid format. Not added.")
        return

    with open(INPUT_FILE, "a") as file:
        file.write(new_entry + "\n")

    print("Entry added.")


def organize_files():
    entries = read_entries()

    if not entries:
        print("No entries found.")
        return

    parsed = [parse_entry(e) for e in entries if parse_entry(e)]

    if not parsed:
        print("No valid entries.")
        return

    choice = organize_menu()


    if choice == "1":
        sorted_entries = sorted(parsed, key=lambda x: x["date"])
        method = "date"

    elif choice == "2":
        sorted_entries = sorted(parsed, key=lambda x: x["subject"].lower())
        method = "subject"

    else:
        sorted_entries = sorted(parsed, key=lambda x: x["name"].lower())
        method = "name"


    output_file = f"organized_by_{method}.txt"

    write_entries(output_file, [x["full"] for x in sorted_entries])

    print(f"\nSaved to {output_file}")


def main():
    while True:
        choice = main_menu()

        if choice == "1":
            organize_files()
        elif choice == "2":
            add_file()
        else:
            print("Goodbye.")
            break


main()
