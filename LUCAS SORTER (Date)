import os
from datetime import datetime, timedelta

def read_filenames(file_list_path):
    with open(file_list_path, 'r') as f:
        return [line.strip() for line in f if line.strip()]

def extract_date(filename):
    try:
        date_part = filename.split('.')[0]
        return datetime.strptime(date_part, "%m-%d-%Y")
    except:
        return None

def get_week_start(date):
    return date if date.weekday() == 6 else date - timedelta(days=date.weekday() + 1)

def get_folder_name(week_start):
    return week_start.strftime("Week of %m-%d-%Y")

def organize_into_folders(file_list_path):
    filenames = read_filenames(file_list_path)

    grouped = {}

    # Group filenames by week
    for filename in filenames:
        date = extract_date(filename)
        if date is None:
            continue

        week_start = get_week_start(date)
        folder_name = get_folder_name(week_start)

        if folder_name not in grouped:
            grouped[folder_name] = []

        grouped[folder_name].append(filename)

    # Create folders + write txt files
    for folder_name, files in grouped.items():
        os.makedirs(folder_name, exist_ok=True)

        output_path = os.path.join(folder_name, "files.txt")

        with open(output_path, 'w') as f:
            for name in files:
                f.write(name + "\n")

organize_into_folders("UNSORTED.txt")
