import os
import shutil
from datetime import datetime, timedelta

def extract_date(filename):
    try:
        date_part = filename.split('.')[0]  # "06-18-2023"
        return datetime.strptime(date_part, "%m-%d-%Y")
    except:
        return None

def get_week_start(date):
    # If it's Sunday, keep it; otherwise go back to previous Sunday
    return date if date.weekday() == 6 else date - timedelta(days=date.weekday() + 1)

def get_folder_name(week_start):
    return week_start.strftime("Week of %m-%d-%Y")

def organize_files(file_list_path):
    with open(file_list_path, 'r') as f:
        filenames = [line.strip() for line in f if line.strip()]
    
    for filename in filenames:
        date = extract_date(filename)
        if date is None:
            continue
        
        week_start = get_week_start(date)
        folder_name = get_folder_name(week_start)
        
        # Create folder
        os.makedirs(folder_name, exist_ok=True)
        
        # Move file (from current directory)
        if os.path.exists(filename):
            shutil.move(filename, os.path.join(folder_name, filename))

organize_files("UNSORTED.txt")
